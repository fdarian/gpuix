{
  "name": "alpina",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "bun run build:native && bun run build:react && bun run build:solid",
    "build:native": "cd packages/native && bun run build",
    "build:react": "cd packages/react && bun run build",
    "build:solid": "cd packages/solid && bun run build",
    "example:counter": "cd examples && bun --hot counter.tsx",
    "dev": "bun scripts/dev.ts",
    "web": "bun scripts/web.ts",
    "web:wasm": "bun scripts/web.ts --build-only",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:release": "bun run build:native && bun run build:solid && bun run build:react && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.0",
    "react-refresh": "^0.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-reconciler": "^0.33.0"
  }
}
