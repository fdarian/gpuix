{
  "name": "@ghia/native",
  "version": "0.11.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./index.js",
  "types": "index.d.ts",
  "browser": "browser.mjs",
  "exports": {
    ".": {
      "browser": "./browser.mjs",
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs",
      "default": "./index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js",
      "default": "./dist/host.js"
    },
    "./screen": {
      "types": "./dist/screen.d.ts",
      "import": "./dist/screen.js",
      "default": "./dist/screen.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./automation": {
      "types": "./dist/automation/index.d.ts",
      "import": "./dist/automation/index.js",
      "default": "./dist/automation/index.js"
    },
    "./cpu-throttle": {
      "types": "./dist/cpu-throttle.d.ts",
      "import": "./dist/cpu-throttle.js",
      "default": "./dist/cpu-throttle.js"
    },
    "./idle-gc": {
      "types": "./dist/idle-gc.d.ts",
      "import": "./dist/idle-gc.js",
      "default": "./dist/idle-gc.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "napi": {
    "binaryName": "gpuix-native",
    "targets": [
      "aarch64-apple-darwin"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdarian/ghia.git",
    "directory": "packages/native"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "napi build --platform --esm --js index.js --release --features test-support && napi build --platform --js index.cjs --release --features test-support && bun run build:js && bun run check:test-support",
    "build:release": "napi build --platform --esm --js index.js --release --no-default-features && napi build --platform --js index.cjs --release --no-default-features && bun run build:js",
    "build:debug": "napi build --platform --esm --js index.js --features test-support && napi build --platform --js index.cjs --features test-support && bun run build:js && bun run check:test-support",
    "build:js": "tsc",
    "check:test-support": "tsc -p tsconfig.test-support.json",
    "build:web": "bun ../../scripts/web.ts --build-only",
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @ghia/native locally. CI is the only release path. See AGENTS.md.'); process.exit(1) }\"",
    "test": "vitest run js/__tests__"
  },
  "dependencies": {
    "eventsource-parser": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "@types/node": "^25.3.3",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "gpuix-native.darwin-arm64.node",
    "browser.mjs",
    "dist",
    "wasm",
    "LICENSE"
  ]
}
