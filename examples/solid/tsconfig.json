{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@ghia/solid",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["bun", "node"],
    "noEmit": true
  },
  "include": ["./*.tsx", "./*.ts"]
}
