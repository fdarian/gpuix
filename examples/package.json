{
  "name": "@ghia/examples",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "blurred-window": "bun --hot blurred-window.tsx",
    "titlebar": "bun --hot titlebar.tsx",
    "counter": "bun --hot counter.tsx",
    "diff": "bun --hot diff.tsx",
    "test": "vitest run --exclude '**/*.perf.test.tsx'",
    "test:perf": "NODE_ENV=production vitest run --no-file-parallelism chat.perf.test.tsx timeline.perf.test.tsx rerender.perf.test.tsx",
    "test:perf:overflow": "NODE_ENV=production vitest run --no-file-parallelism overflow-clip.perf.test.tsx",
    "test:perf:menus": "NODE_ENV=production vitest run --no-file-parallelism command-menus.perf.test.tsx",
    "test:perf:cq": "NODE_ENV=production vitest run --no-file-parallelism container-queries.perf.test.tsx",
    "test:perf:svg": "NODE_ENV=production vitest run --no-file-parallelism svg-raster.perf.test.tsx",
    "test:perf:depth": "NODE_ENV=production vitest run --no-file-parallelism depth-col.perf.test.tsx",
    "test:perf:animating": "NODE_ENV=production vitest run --no-file-parallelism one-animating-node.perf.test.tsx",
    "test:perf:clipped": "NODE_ENV=production vitest run --no-file-parallelism clipped.perf.test.tsx",
    "test:perf:retain": "NODE_ENV=production vitest run --no-file-parallelism retain.perf.test.tsx",
    "test:perf:layout-idle": "NODE_ENV=production vitest run --no-file-parallelism layout-idle.perf.test.tsx",
    "test:perf:draws": "NODE_ENV=production vitest run --no-file-parallelism draws-vs-presents.perf.test.tsx",
    "test:perf:swap": "NODE_ENV=production vitest run --no-file-parallelism page-swap.perf.test.tsx",
    "native-text":"bun --hot native-text.tsx",
    "chat": "bun --hot chat.tsx",
    "chat-solid": "bun --hot solid/chat.tsx",
    "infinite-chat": "bun --hot infinite-chat.tsx",
    "timeline": "bun --hot timeline.tsx",
    "mail": "bun --hot mail.tsx",
    "compile": "bun compile-chat.ts",
    "bench:serde": "bun bench-serialization.ts"
  },
  "dependencies": {
    "@ghia/react": "workspace:^",
    "@ghia/solid": "workspace:^",
    "solid-js": "1.9.15",
    "@kmamal/sdl": "^0.11.12",
    "diff": "^7.0.0",
    "react": "^19.2.4",
    "safe-mdx": "1.14.0",
    "shiki": "^3.0.0",
    "string-dedent": "^3.0.2"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.0",
    "cbor-x": "^1.6.6",
    "msgpackr": "^2.0.6",
    "tsx": "^4.19.0",
    "vitest": "^4.0.18"
  }
}
